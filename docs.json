{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ChatATP Studio Documentation",
  "colors": {
    "primary": "#6366F1",
    "light": "#818CF8",
    "dark": "#4338CA"
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/logo/light.jpeg",
    "dark": "/logo/dark.jpeg"
  },
  "api": {
    "mdx": {
      "server": "https://chatatp-agent-builder-backend.onrender.com",
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "embedding",
              "cli/overview"
            ]
          }
        ]
      },
      {
        "tab": "JavaScript SDK",
