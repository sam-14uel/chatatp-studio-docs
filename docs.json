        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "js/installation",
              "js/authentication"
            ]
          },
          {
            "group": "Copilot Components",
            "pages": [
              "js/copilot-components"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "js/agents",
              "js/conversations",
              "js/messages",
              "js/streaming",
              "js/pagination",
              "js/errors"
            ]
          }
        ]
      },
      {
        "tab": "Python SDK",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "python/installation",
              "python/authentication"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "python/agents",
              "python/conversations",
              "python/messages",
              "python/streaming",
              "python/pagination",
              "python/errors"
            ]
          }
        ]
